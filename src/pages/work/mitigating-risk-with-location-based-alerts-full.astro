---
// The INSO case in its full version (src/content/projects/mitigating-risk-with-location-based-alerts.mdoc),
// for comparing with the short one now shown at /work/mitigating-risk-with-location-based-alerts/. Not listed
// on the home page or in "Next project" links. Remove with the comparison bar once a version is chosen.
import { getProjects } from '../../lib/data';
import CaseA from '../../components/next/va/CaseA.astro';

const projects = await getProjects();
const project = projects.find((p) => p.id === 'mitigating-risk-with-location-based-alerts')!;
const next = projects.find((p) => p.id === 'ngosafety-website-redesign')!;
---
<CaseA project={project} next={next} base="/" look="blue" compare="full" />
