---
// Frozen review copy of the INSO full case as it was on 2 Nov 2026, with its proposed-cut notes
// (src/content/lab/inso-app-review.mdoc). Not linked from anywhere; noindex like every Next page.
import { getEntry } from 'astro:content';
import CaseA from '../../../components/next/va/CaseA.astro';
import { getProjects } from '../../../lib/data';

const projects = await getProjects();
const project = (await getEntry('lab', 'inso-app-review'))!;
const next = projects.find((p) => p.id === 'ngosafety-website-redesign')!;
---
