---
// The INSO case in its Simple version (src/content/lab/inso-app-simple.mdoc, docs/claude-code-instructions-simple-layout-v2.md):
// the short text with quieter blocks (icon + narrative title + paragraph, no labels or boxes) and the full video
// at the top; the reading experience of docs/claude-code-instructions-reading-experience.md. Styles scoped to .cs-simple (styles/case-simple.css), so the full and short versions don't change.
// Not indexed, not listed on the home page or in "Next project" links. Remove with the comparison bar.
import { getEntry } from 'astro:content';
import { getProjects } from '../../lib/data';
import CaseA from '../../components/next/va/CaseA.astro';
import CaseComments from '../../components/CaseComments.astro';
import '../../styles/case-simple.css';

const projects = await getProjects();
const project = (await getEntry('lab', 'inso-app-simple'))!;
const next = projects.find((p) => p.id === 'ngosafety-website-redesign')!;
---
<CaseA project={project} next={next} base="/" look="blue" compare="simple" fullVideo={{ src: '/video/inso/one-alert-story-v17.mp4', poster: '/video/inso/one-alert-story-cover.jpg', length: '1:27', caption: 'Watch: How does INSO alerts help humanitarian workers stay safe on the job?' }}>
  <CaseComments />
</CaseA>

<script>
  import '../../scripts/sequence'; // flows shown one screen at a time
  import '../../scripts/lightbox'; // enlarge any image
  import '../../scripts/video-controls'; // a clear play/pause on videos
  // two variants of the titles to compare: serif paragraph titles under a small section label (default), or
  // ?titles=sans: the label and the title on one line, in bold sans ("Alerts: The main screen had…"); ?titles=small:
  // the serif variant with the small sans titles that were taken off the paragraphs shown again, to compare
  const root = document.documentElement;
  const titles = new URLSearchParams(location.search).get('titles');
  if (titles === 'sans' || titles === 'small') root.dataset.titles = titles;
  document.querySelectorAll<HTMLAnchorElement>('[data-titles-link]').forEach((a) => { if (a.dataset.titlesLink === (root.dataset.titles ?? '')) a.setAttribute('aria-current', 'true'); });
  document.querySelectorAll<HTMLElement>('.a-story h2').forEach((h) => { const lead = h.nextElementSibling as HTMLElement | null; if (lead?.matches('p') && lead.children.length === 1 && lead.firstElementChild!.tagName === 'STRONG') { h.classList.add('has-lead'); lead.dataset.section = h.textContent ?? ''; } });
  // icons are flipbooks (docs/icons/build.mjs): each plays its frames (twice) when its block reaches the middle of
  // the screen, and again on hover; with reduced motion each shows its standing frame
  // each plays twice through (a short hold between), then stops on its last frame
  const play = (svg: SVGElement & { _t?: number }) => {
    const once = (svg.dataset.timeline ?? '').split(' ').map((s) => s.split(':').map(Number));
    const steps = [...once.slice(0, -1), [once[once.length - 1][0], 700], ...once];
    let i = 0;
    clearTimeout(svg._t);
    const next = () => { svg.dataset.frame = String(steps[i][0]); const ms = steps[i][1]; i++; if (i < steps.length) svg._t = window.setTimeout(next, ms); };
    next();
  };
  // an icon on a block that opens its section (or follows a heading) goes above the label or heading, never
  // between them and the text
  document.querySelectorAll<HTMLElement>('.a-story .cs-block').forEach((block) => {
    let prev = block.previousElementSibling;
    if (prev?.matches('p') && prev.children.length === 1 && prev.firstElementChild!.tagName === 'STRONG') prev = prev.previousElementSibling; // the section's headline
    const icon = block.querySelector('.cs-block__icon');
    if (!prev?.matches('h2, h3') || !icon) return;
    const holder = document.createElement('div');
    holder.className = `cs-block cs-sec-icon ${[...block.classList].filter((c) => c.startsWith('cs-block--')).join(' ')}`;
    holder.innerHTML = '<div class="cs-block__head"></div>';
    holder.firstElementChild!.append(icon);
    prev.before(holder);
  });
  const icons = [...document.querySelectorAll<SVGElement>('.cs-block__icon svg')];
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) icons.forEach((svg) => { svg.dataset.frame = svg.dataset.rest; });
  else {
    const middle = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const svg = e.target.querySelector<SVGElement>('.cs-block__icon svg');
      if (svg) play(svg);
      middle.unobserve(e.target);
    }), { rootMargin: '-45% 0px -45% 0px' });
    icons.forEach((svg) => {
      const block = svg.closest<HTMLElement>('.cs-block')!;
      middle.observe(block);
      block.addEventListener('mouseenter', () => play(svg));
    });
  }
</script>
