---
// The INSO case in its Simple version (src/content/lab/inso-app-simple.mdoc, docs/claude-code-instructions-simple-layout-v2.md):
// the short text with quieter blocks (icon + narrative title + paragraph, no labels or boxes) and the full video
// at the top. Styles scoped to .cs-simple (styles/case-simple.css), so the full and short versions don't change.
// Not indexed, not listed on the home page or in "Next project" links. Remove with the comparison bar.
import { getEntry } from 'astro:content';
import { getProjects } from '../../lib/data';
import CaseA from '../../components/next/va/CaseA.astro';
import '../../styles/case-simple.css';

const projects = await getProjects();
const project = (await getEntry('lab', 'inso-app-simple'))!;
const next = projects.find((p) => p.id === 'ngosafety-website-redesign')!;
---
<CaseA project={project} next={next} base="/" look="blue" compare="simple" fullVideo={{ src: '/video/inso/one-alert-story-v17.mp4', poster: '/video/inso/one-alert-story-cover.jpg' }} />

<script>
  const root = document.documentElement;
  // each icon plays its animation once its block reaches the middle of the screen, and again on hover
  // (not with reduced motion: the icons stay as drawn)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    root.classList.add('has-icon-anim');
    const middle = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-play'); middle.unobserve(e.target); } }), { rootMargin: '-45% 0px -45% 0px' });
    document.querySelectorAll<HTMLElement>('.cs-block').forEach((b) => {
      middle.observe(b);
      b.addEventListener('mouseenter', () => {
        if (b.classList.contains('is-play')) b.querySelectorAll('.cs-block__icon *').forEach((el) => el.getAnimations().forEach((an) => { an.currentTime = 0; an.play(); }));
      });
    });
  }
</script>
