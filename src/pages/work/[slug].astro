---
// Case studies (/work/<slug>/), on version A's case template in the blue colours
// (components/next/va/CaseA.astro). "Next project" follows the home page order and wraps around.
// The INSO case shows its short version (src/content/lab/inso-app-short.mdoc) with its full video as the
// cover (#full-video, which the home page's "Full video" link opens and plays); the full version is at /work/mitigating-risk-with-location-based-alerts-full/.
import { getEntry } from 'astro:content';
import CaseA from '../../components/next/va/CaseA.astro';
import { getProjects } from '../../lib/data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({ params: { slug: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}

const { project, next } = Astro.props;
const inso = project.id === 'mitigating-risk-with-location-based-alerts';
const shown = inso ? (await getEntry('lab', 'inso-app-short'))! : project;
---
<CaseA project={shown} next={next} base="/" look="blue" compare={inso ? 'short' : undefined} fullVideo={inso ? { src: '/video/inso/one-alert-story-v17.mp4', poster: '/video/inso/one-alert-story-cover.jpg', length: '1:27', caption: 'Watch: How does INSO alerts help humanitarian workers stay safe on the job?' } : undefined} />
