---
// --cut: an uneven paper edge (lib/papercut.ts), seeded by the value so each card is cut differently; the strip uses it
import { unevenRect } from '../../lib/papercut';
interface Props { value: string; label: string }
const { value, label } = Astro.props;
const seed = [...value].reduce((n, c) => n + c.charCodeAt(0), 0);
---
<li class="cs-stat" style={`--cut:${unevenRect(seed, 1.6)}`}><span class="cs-stat__value">{value}</span> <span class="cs-stat__label">{label}</span></li>
