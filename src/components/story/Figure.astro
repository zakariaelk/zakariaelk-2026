---
// A visual with a job. Wider than the text column by default; "text" keeps it in the column,
// "half" is used inside a before/after pair. frame: before (grey) | after (blue) | compare
// (one visual holding both, grey left and blue right). Videos play only while on screen and
// never with reduced motion.
import { Image, getImage } from 'astro:assets';
import { assetImage, posterFor } from '../../lib/media';

// related: the visual shows the data of the result just above it, so it stays close to it
// badges: numbered badges over the image ("x,y|x,y", in % of its size), matching the numbered rows of a table
interface Props { src: string; alt: string; caption?: string; frame?: string; size?: string; notes?: string; related?: boolean; badges?: string }
const { src, alt, caption, frame = '', size = 'wide', notes, related = false, badges } = Astro.props;
const badgeList = badges?.split('|').map((b) => b.split(',').map((v) => v.trim())) ?? [];
const isVideo = /\.mp4$/i.test(src);
const img = isVideo ? undefined : assetImage(src);
if (!isVideo && !img) throw new Error(`Figure: image not found in src/assets: ${src}`);
const poster = isVideo ? posterFor(src) : undefined;
const posterImg = poster ? await getImage({ src: poster, format: 'webp', width: 1280 }) : undefined;
const sizes = size === 'half' ? '(min-width: 1200px) 560px, (min-width: 760px) 46vw, 100vw'
  : size === 'text' ? '(min-width: 760px) 640px, 100vw'
  : '(min-width: 1200px) 1140px, 100vw';
const noteList = notes?.split('|').map((s) => s.trim()).filter(Boolean) ?? [];
// landscape or portrait, from the media's own size (a video's from its poster): the Simple case sizes them by it
const dims = isVideo ? poster : img;
const orient = dims && dims.width / dims.height < 1.1 ? 'portrait' : 'landscape';
const label = frame === 'before' ? 'Before' : frame === 'after' ? 'After' : '';
---
<figure class:list={['cs-figure', `cs-figure--${size}`, frame && `cs-frame--${frame}`]} data-orient={orient} data-related={related ? '' : undefined}>
  {label && <p class="cs-frame__label">{label}</p>}
  {frame === 'compare' && <p class="cs-frame__labels" aria-hidden="true"><span>Before</span><span>After</span></p>}
  <div class="cs-media">
    {isVideo ? (
      <video class="cs-video" muted loop playsinline preload="none" poster={posterImg?.src} width={poster?.width} height={poster?.height} aria-label={alt}>
        <source src={src} type="video/mp4" />
      </video>
    ) : (
      <Image src={img!} alt={alt} widths={[640, 960, 1280, 1680]} sizes={sizes} loading="lazy" decoding="async" />
    )}
    {badgeList.length > 0 && <div class="cs-badges" aria-hidden="true">{badgeList.map(([x, y], i) => <span class="cs-num" style={`left:${x}%;top:${y}%`}>{i + 1}</span>)}</div>}
  </div>
  {noteList.length > 0 && <ol class="cs-notes" aria-label="What changed">{noteList.map((n) => <li>{n}</li>)}</ol>}
  {caption && <figcaption>{label && <span class="cs-cap__frame">{label}: </span>}{caption}</figcaption>}
</figure>
