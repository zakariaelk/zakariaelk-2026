---
// Before/after pair: before (grey) always first, after (blue) second. Stacks on small screens.
interface Props { caption?: string }
const { caption } = Astro.props;
---
<figure class="cs-pair">
  <div class="cs-pair__grid"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
