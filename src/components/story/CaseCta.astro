---
// The case's "Take a look" button (the paper cut-out of components/next/va/CaseA.astro), placed in the story
// (the Simple INSO case: under the usage chart). Opens the product in a new tab; a link within the site (the INSO
// short version's "Read the full case study") opens in place, with an arrow instead of the eye.
import { ctaEye as eye } from '../../lib/cta-eye'; // the paper eye of the buttons

interface Props { href: string; label?: string }
const { href, label = 'Take a look' } = Astro.props;
const external = /^https?:/i.test(href);
const host = href.replace(/^https?:\/\/(www\.)?/i, '').replace(/\/$/, '');
---
<p class="cs-cta">
  <a class="a-cta" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
    <span class="a-cta__paper" data-ring="11" aria-hidden="true"></span>
    {label}
    {external ? <span class="a-cta__eye" set:html={eye()} /> : <svg class="a-cta__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" /></svg>}
    {external && <span class="sr-only"> at {host} (opens in a new tab)</span>}
  </a>
</p>
