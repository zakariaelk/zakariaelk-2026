---
// A video with sound behind a play button (the one-minute story): its cover until someone presses
// play, then the video with its own controls (full screen, speed), in place. Nothing loads before that.
// align: where the play button sits on the cover; endHref/endLabel: at the end, a button on to the case.
import { getImage } from 'astro:assets';
import { posterFor } from '../../lib/media';

interface Props { src: string; title: string; caption?: string; length?: string; align?: 'left' | 'right'; endHref?: string; endLabel?: string }
const { src, title, caption, length, align = 'right', endHref, endLabel = 'See case study' } = Astro.props;
const poster = posterFor(src);
const posterSrc = poster ? (await getImage({ src: poster, format: 'webp', width: 1920 })).src : undefined;
---
<figure class:list={['cs-figure cs-figure--wide cs-player', align === 'left' && 'cs-player--left']} data-player>
  <div class="cs-player__frame">
    <video class="cs-player__video" src={src} poster={posterSrc} width={poster?.width} height={poster?.height} preload="none" playsinline aria-label={title}></video>
    <button type="button" class="cs-player__play" aria-label={`Play: ${title}`} style={posterSrc ? `background-image:url(${posterSrc})` : undefined}>
      <span class="cs-player__pill"><span class="cs-player__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span><span>Play{length && <span class="cs-player__len"> · {length}</span>}</span></span>
    </button>
    {endHref && (
      <div class="cs-player__end">
        <a class="a-cta" href={endHref}><span class="a-cta__paper" data-ring="17" aria-hidden="true"></span>{endLabel}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" /></svg></a>
        <button type="button" class="cs-player__again">Watch again</button>
      </div>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((fig) => {
    const video = fig.querySelector<HTMLVideoElement>('video')!;
    const button = fig.querySelector<HTMLButtonElement>('.cs-player__play')!;
    button.addEventListener('click', () => {
      fig.classList.add('is-playing');
      video.controls = true;
      video.play().catch(() => {});
      video.focus();
    });
    // at the end: the way on to the case study (if there is one) and a replay
    video.addEventListener('ended', () => { if (video.controls) video.controls = false; fig.classList.add('is-ended'); });
    fig.querySelector('.cs-player__again')?.addEventListener('click', () => {
      fig.classList.remove('is-ended');
      video.controls = true;
      video.currentTime = 0;
      video.play().catch(() => {});
    });
  });
  import '../../scripts/paper-ring';
</script>
