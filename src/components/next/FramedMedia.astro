---
// A visual in the light-gray painted frame (shared by both versions): an image, or a video that
// plays while on screen, with the frame tilted a touch. frame={false}: the visual alone. cut: a
// clip-path that trims the visual like a piece of paper cut out with scissors (soft shadow under it).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brushFrame } from '../../lib/papercut';

interface Props { image: ImageMetadata; alt: string; video?: string; posterSrc?: string; seed?: number; tilt?: string; sizes?: string; eager?: boolean; thick?: number; frame?: boolean; cut?: string; class?: string }
const { image, alt, video, posterSrc, seed = 7, tilt = '-0.4deg', sizes = '(min-width: 1440px) 1312px, 92vw', eager = false, thick = 0.6, frame = true, cut, class: cls } = Astro.props;
const clip = cut ? `clip-path:${cut}` : undefined;
---
<div class:list={['v-frame', cut && 'v-frame--cut', cls]}>
  {frame && <svg class="n-brush" style={`--tilt:${tilt}`} viewBox="-20 -20 1040 640" preserveAspectRatio="none" aria-hidden="true"><path d={brushFrame(seed, 1000, 600, thick)} /></svg>}
  {video ? (
    <video class="v-video" src={video} poster={posterSrc} width={image.width} height={image.height} muted loop playsinline preload="none" aria-label={alt} style={clip}></video>
  ) : (
    <Image src={image} alt={alt} widths={[640, 960, 1280, 1600, 2000]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} style={clip} />
  )}
</div>

<script>
  import '../../scripts/play-in-view';
</script>
