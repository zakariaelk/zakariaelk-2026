---
// Header: the name (morphs into its Arabic form every few seconds; the round Z / ز logo is the
// favicon), "say my name" speaker, nav, light/dark switch. With logo (version A) the header shows
// the round Z / ز alone; the name and the speaker move into the page's intro.
import ArabicNameAmiri from './ArabicNameAmiri.astro';
import NextLogo from './NextLogo.astro';
import settings from '../../content/pages/settings.json';

const CV = '/cv/Zakaria-El-Khachia-CV.pdf';

// logo: the round Z / ز instead of the name and speaker (version A); work / contact: where those links point
interface Props { base?: string; contact?: string; work?: string; logo?: boolean }
const { base = '/next/', contact = `${base}#contact`, work = `${base}#work`, logo = false } = Astro.props;
---
<header class="n-head">
  <div class:list={['n-brand', logo && 'n-brand--logo']}>
    {logo ? (
      <a href={base} class="n-brand__logo" aria-label="Zakaria El Khachia, home"><NextLogo variant="blue" seed={23} size={90} decorative /></a>
    ) : (
      <>
        <a href={base} class="n-name">
          <span class="n-name__latin">Zakaria El Khachia</span>
          <ArabicNameAmiri />
        </a>
        <button type="button" class="n-icon n-say" aria-label="Hear how to say Zakaria El Khachia" data-audio="/audio/zakaria-el-khachia.mp3">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 9.5h3l4.5-4v13L7 14.5H4z" />
            <path class="wave" d="M15 9.2a4 4 0 0 1 0 5.6" />
            <path class="wave" d="M17.8 6.6a7.6 7.6 0 0 1 0 10.8" />
          </svg>
        </button>
      </>
    )}
  </div>
  <!-- Phones (version A): the light/dark switch sits beside the menu button instead of inside the menu -->
  {logo && <button type="button" class="n-icon n-theme n-theme--bar" aria-label="Switch to dark mode"><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" /></svg></button>}
  <!-- Phones: a brown paper square with two white bars opens the menu full screen (like ensemblelapalatine.com) -->
  <button type="button" class="n-burger" aria-label="Menu" aria-expanded="false" aria-controls="n-menu">
    <span class="n-burger__bar"></span><span class="n-burger__bar"></span>
  </button>
  <nav class="n-nav" id="n-menu" aria-label="Main">
    <a href={work}>Work</a>
    <a href={`${base}about/`}>About</a>
    <a href={contact}>Contact</a>
    {logo && <a href={CV} target="_blank" rel="noopener">CV</a>}
    <button type="button" class="n-icon n-theme" aria-label="Switch to dark mode">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" />
      </svg>
    </button>
    {logo && (
      <div class="n-nav__foot">
        <a href={settings.linkedin} target="_blank" rel="noopener"><span class="n-nav__paper" data-paper data-seed="7" aria-hidden="true"></span>LinkedIn</a>
        <a href={CV} target="_blank" rel="noopener"><span class="n-nav__paper" data-paper data-seed="23" data-anchor="right" aria-hidden="true"></span>Download CV</a>
      </div>
    )}
  </nav>
</header>

<script>
  import '../../scripts/paper'; // the phone menu's LinkedIn / CV cut-outs
  // Say my name (the speaker in the header, or in the intro in version A)
  let audio: HTMLAudioElement | null = null;
  let stopAt = 0;
  document.querySelectorAll<HTMLButtonElement>('.n-say').forEach((say) => say.addEventListener('click', () => {
    audio ??= new Audio(say.dataset.audio);
    audio.currentTime = 0;
    say.classList.add('is-playing'); // the waves pulse while it plays
    const stop = () => { clearTimeout(stopAt); say.classList.remove('is-playing'); };
    audio.onended = audio.onpause = audio.onerror = stop;
    // and in any case once the clip's length has passed
    clearTimeout(stopAt);
    stopAt = window.setTimeout(stop, ((Number.isFinite(audio.duration) && audio.duration) || 2.2) * 1000 + 400);
    audio.play().catch(stop);
  }));

  // Phone menu: full-screen panel; closes on Escape, on a link, or on the button again
  const burger = document.querySelector<HTMLButtonElement>('.n-burger');
  const setMenu = (open: boolean) => {
    document.documentElement.classList.toggle('is-menu-open', open);
    burger?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    // the logo stays on top of the menu (in its light colours) and spins once as the menu opens
    if (open && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('is-logo-spin');
      window.setTimeout(() => document.documentElement.classList.remove('is-logo-spin'), 1500);
    }
  };
  burger?.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('#n-menu a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') { setMenu(false); burger.focus(); } });
  window.matchMedia('(min-width: 701px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  // Light / dark: remembered for next time
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('.n-theme');
  const label = () => toggles.forEach((t) => t.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'));
  label();
  toggles.forEach((toggle) => toggle.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('ze-theme', root.dataset.theme); } catch {}
    label();
  }));
</script>
