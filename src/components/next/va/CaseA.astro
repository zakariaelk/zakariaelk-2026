---
// Version A case study, after hansonwu.com/game-breakdowns and the layout sketch v3
// (docs/case-study-layout-sketch-for-claude-code.md): a light start, proof early, details as they come.
//   client → headline → hero (full content width) → one or two intro paragraphs → facts (2×2) → "Take a look"
//   then the story in an 860px column (opening with "The reality of this project"), visuals wider, and the next project.
// A slim rail at the far left lists the sections: open beside the first section, it sticks as the page
// scrolls and folds to its strokes after ~350px (names on hover); the current section's stroke is longer.
// Used by /work/<slug>/ and the /next/… and /tests variations: base = where the links stay,
// look = their colour or type variation.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Next from '../../../layouts/Next.astro';
import FramedMedia from '../FramedMedia.astro';
import StoryVideo from '../../story/StoryVideo.astro';
import ContactA from './ContactA.astro';
import type { CollectionEntry } from 'astro:content';
import { caseHref } from '../../../lib/versions';
import { cutLine } from '../../../lib/papercut';
import '../../../styles/next-a.css';
import '../../../styles/next-a-looks.css';
import '../../../styles/case-a.css';

// compare: a temporary bar linking the full and short versions of the INSO case (remove with the short page)
// heroPlayer: a video with sound as the hero, behind a play button, its cover from posters/ (the INSO case)
interface Props { project: CollectionEntry<'projects' | 'lab'>; next: CollectionEntry<'projects'>; base?: string; look?: 'orange' | 'dmsans' | 'blue' | 'brown'; compare?: 'full' | 'short'; heroPlayer?: string }
const { project, next, base = '/next/a/', look, compare, heroPlayer } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const labelOf = (p: CollectionEntry<'projects' | 'lab'>['data']) => p.org ?? p.client; // the client's name
const meta = [
  { label: 'Role', value: d.role },
  { label: 'Team', value: d.team },
  { label: 'Timeline', value: d.duration },
  { label: 'Deliverables', value: d.deliverables },
].filter((m) => m.value) as { label: string; value: string }[];
const rows = [meta.slice(0, 2), meta.slice(2)].filter((r) => r.length);
// rail: the body's section names (its h2s)
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
---
<Next base={base} variant="a" logo look={look} title={`${d.projectName ?? d.title} · Zakaria El Khachia`} description={d.statement ?? d.intro}>

  {compare && (
    <p class="a-wrap a-compare">Comparing versions:{' '}<a href="/work/mitigating-risk-with-location-based-alerts-full/" aria-current={compare === 'full' ? 'page' : undefined}>Full</a>{' · '}<a href="/work/mitigating-risk-with-location-based-alerts/" aria-current={compare === 'short' ? 'page' : undefined}>Short</a></p>
  )}
  <header class="a-wrap a-case" id="top">
    <p class="a-case__label">{labelOf(d)}</p>
    <h1 class="a-case__title">{d.headline}</h1>
  </header>

  <div class="a-wrap a-case__hero">
    {heroPlayer ? <StoryVideo src={heroPlayer} title="One alert, a different turn: the story in one minute" length="1:23" /> : <FramedMedia frame={false} image={d.cover} alt={`${labelOf(d)}: ${d.projectName ?? d.title}`} sizes="(min-width: 1440px) 1340px, 100vw" eager />}
  </div>

  <div class="a-wrap">
    <div class="a-col a-case__intro">
      {d.lede.map((p) => <p class="a-case__lede">{p}</p>)}
      {rows.map((r, i) => (
        <Fragment>
          {i > 0 && <svg class="a-case__rule" viewBox="0 0 1000 24" preserveAspectRatio="none" aria-hidden="true"><path d={cutLine(37)} /></svg>}
          <dl class="a-case__meta">{r.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl>
        </Fragment>
      ))}
      {d.link && (
        <a class="a-case__cta" href={d.link} target="_blank" rel="noopener">
          <span class="a-case__cta-paper" aria-hidden="true"></span>
          Take a look
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" /></svg>
          <span class="sr-only"> at {d.link.replace(/^https?:\/\/(www\.)?/i, '').replace(/\/$/, '')} (opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>


  <!-- the story, with the section rail in the left margin: it starts open beside the first section,
       sticks as the page scrolls and folds to its strokes after ~350px -->
  <div class="a-reading">
    {sections.length > 2 && (
      <div class="a-rail-track">
        <nav class="a-rail" aria-label="Sections">
          <ol>
            {sections.map((s) => <li><a href={`#${s.id}`} data-section={s.id}><span class="a-rail__tick" aria-hidden="true"></span><span class="a-rail__label">{s.label}</span></a></li>)}
          </ol>
          <a class="a-rail__top" href="#top"><span class="a-rail__tick" aria-hidden="true"></span><span class="a-rail__label">Back to top</span></a>
        </nav>
      </div>
    )}
    <div class="a-story a-wrap" data-story>
      <Content />
    </div>
  </div>

  <nav class="a-wrap a-next" aria-label="Next project">
    <a class="a-col a-next__link" href={caseHref(base, next.id)}>
      <span class="a-next__text">
        <span class="a-case__label">Next project</span>
        <span class="a-next__title">{labelOf(next.data)} — {next.data.headline}</span>
      </span>
      <Image class="a-next__thumb" src={next.data.cover} alt="" width={700} sizes="(min-width: 900px) 350px, 100vw" />
    </a>
  </nav>

  <ContactA />
</Next>

<script>
  import '../../../scripts/case-enhance';
  import { paperRing } from '../../../lib/papercut';
  // "Take a look": a paper cut-out whose rough edge circles round on hover (stop-motion steps, like
  // the logo's turn) while the shape itself stays put
  const cta = document.querySelector<HTMLElement>('.a-case__cta');
  const paper = cta?.querySelector<HTMLElement>('.a-case__cta-paper');
  if (cta && paper) {
    let phase = 0;
    let timer = 0;
    const draw = () => { paper.style.clipPath = `path('${paperRing(paper.offsetWidth, paper.offsetHeight, 11, phase)}')`; };
    new ResizeObserver(draw).observe(paper);
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const start = () => { if (still.matches || timer) return; timer = window.setInterval(() => { phase += 1; draw(); }, 140); };
    const stop = () => { clearInterval(timer); timer = 0; };
    cta.addEventListener('pointerenter', start);
    cta.addEventListener('pointerleave', stop);
    cta.addEventListener('focus', start);
    cta.addEventListener('blur', stop);
  }
  // highlighted sentences ({% mark %}) are drawn in once they are well into the screen
  const marks = document.querySelectorAll<HTMLElement>('.cs-mark');
  const seen = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-drawn'); seen.unobserve(e.target); } }), { rootMargin: '0px 0px -25% 0px' });
  marks.forEach((m) => seen.observe(m));
  // Rail: the current section is the last one whose heading passed the top third of the screen.
  // It stays open until the page has scrolled ~350px past the point where the rail sticks.
  const rail = document.querySelector<HTMLElement>('.a-rail');
  const track = document.querySelector<HTMLElement>('.a-rail-track');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.a-rail [data-section]')];
  const targets = links.map((a) => document.getElementById(a.dataset.section!)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    let active = '';
    let ticking = false;
    const update = () => {
      ticking = false;
      if (rail && track) {
        const stuckFor = parseFloat(getComputedStyle(rail).top) - track.getBoundingClientRect().top; // px scrolled since it stuck
        rail.classList.toggle('is-open', stuckFor < 350);
      }
      const line = innerHeight * 0.33;
      let id = '';
      targets.forEach((t) => { if (t.getBoundingClientRect().top < line) id = t.id; });
      if (id === active) return;
      active = id;
      links.forEach((a) => (a.dataset.section === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    update();
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  }
</script>
