---
// Version A case study, after hansonwu.com/game-breakdowns and the layout sketch v3
// (docs/case-study-layout-sketch-for-claude-code.md): a light start, proof early, details as they come.
//   client → headline → hero (full content width) → one or two intro paragraphs → facts (2×2) → "Take a look"
//   then the story in an 860px column (opening with "The reality of this project"), visuals wider, and the next project.
// A slim rail at the far left lists the sections: open beside the first section, it sticks as the page
// scrolls and folds to its strokes after ~350px (names on hover); the current section's stroke is longer.
// Used by /work/<slug>/ and the /next/… and /tests variations: base = where the links stay,
// look = their colour or type variation.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Next from '../../../layouts/Next.astro';
import FramedMedia from '../FramedMedia.astro';
import CaseStudyVideo from '../../video/CaseStudyVideo.astro';
import ContactA from './ContactA.astro';
import type { CollectionEntry } from 'astro:content';
import { caseHref } from '../../../lib/versions';
import { cutLine, unevenRect } from '../../../lib/papercut';
import '../../../styles/next-a.css';
import '../../../styles/next-a-looks.css';
import '../../../styles/case-a.css';
import '../../../styles/media-a.css';

// compare: a small "versions" tooltip beside the title, linking the full, short and simple versions of the INSO case
// (remove with those pages);
// 'simple' also scopes that page's own styles (styles/case-simple.css) with .cs-simple on <body>
// fullVideo: the case's full video as its cover (components/video/CaseStudyVideo.astro, #full-video)
interface Props { project: CollectionEntry<'projects' | 'lab'>; next: CollectionEntry<'projects'>; base?: string; look?: 'orange' | 'dmsans' | 'blue' | 'brown'; compare?: 'full' | 'short' | 'simple'; fullVideo?: { src: string; poster: string; length?: string; caption?: string } }
const { project, next, base = '/next/a/', look, compare, fullVideo } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const labelOf = (p: CollectionEntry<'projects' | 'lab'>['data']) => p.org ?? p.client; // the client's name
// the facts: each one line or a list; team members as "name – role", the name a link when a URL is given
type Item = string | { name: string; role?: string; url?: string };
const list = (v?: Item | Item[]) => (v === undefined ? [] : Array.isArray(v) ? v : [v]);
const meta = [
  { label: 'Role', items: list(d.role) },
  { label: 'Team', items: list(d.team) },
  { label: 'Timeline', items: list(d.duration) },
  { label: 'Deliverables', items: list(d.deliverables) },
].filter((m) => m.items.length);
const rows = [meta.slice(0, 2), meta.slice(2)].filter((r) => r.length);
// rail: the body's section names (its h2s)
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
// the rail and the phone menu start with "Intro": the title and the cover
const nav = [{ id: 'top', label: 'Intro' }, ...sections];
---
<Next base={base} variant="a" logo look={look} bodyClass={compare === 'simple' ? 'cs-simple' : undefined} title={`${d.projectName ?? d.title} · Zakaria El Khachia`} description={d.statement ?? d.intro}>

  {sections.length > 2 && (
    <div class="a-toc" data-toc>
      <button type="button" class="a-toc__bar" aria-expanded="false" aria-controls="a-toc-list">
        <span class="a-toc__name">Contents</span><span class="a-toc__sep" aria-hidden="true">¬</span><span class="a-toc__current" data-toc-current>Intro</span>
        <svg class="a-toc__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6" /></svg>
      </button>
      <nav class="a-toc__panel" id="a-toc-list" aria-label="Sections" hidden style={`clip-path:${unevenRect(43, 0.6)}`}>
        <ol>{nav.map((s) => <li><a href={`#${s.id}`} data-section={s.id}>{s.label}</a></li>)}</ol>
      </nav>
    </div>
  )}
  <header class="a-wrap a-case" id="top">
    <p class="a-case__label">{labelOf(d)}</p>
    <h1 class="a-case__title">{d.headline}</h1>
    {compare && (
      <details class="a-versions">
        <summary aria-label="Versions of this case study"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" /></svg></summary>
        <div class="a-versions__panel">
          <p>Comparing versions</p>
          <ul>
            <li><a href="/work/mitigating-risk-with-location-based-alerts-full/" aria-current={compare === 'full' ? 'page' : undefined}>Full</a></li>
            <li><a href="/work/mitigating-risk-with-location-based-alerts/" aria-current={compare === 'short' ? 'page' : undefined}>Short</a></li>
            <li><a href="/work/mitigating-risk-with-location-based-alerts-simple/" aria-current={compare === 'simple' ? 'page' : undefined}>Simple</a></li>
          </ul>
          {compare === 'simple' && <Fragment><p>Titles</p><ul><li><a href="?" data-titles-link="">Serif</a></li><li><a href="?titles=sans" data-titles-link="sans">Sans</a></li><li><a href="?titles=small" data-titles-link="small">With small titles</a></li></ul></Fragment>}
        </div>
      </details>
    )}
  </header>

  <div class="a-wrap a-case__hero">
    {fullVideo ? <CaseStudyVideo src={fullVideo.src} poster={fullVideo.poster} length={fullVideo.length} title={fullVideo.caption ?? 'One alert, a different turn: the story in one minute'} caption={fullVideo.caption} /> : <FramedMedia frame={false} image={d.cover} alt={`${labelOf(d)}: ${d.projectName ?? d.title}`} sizes="(min-width: 1440px) 1340px, 100vw" eager />}
  </div>

  <div class="a-wrap">
    <div class="a-col a-case__intro">
      {d.lede.map((p) => <p class="a-case__lede">{p}</p>)}
      {rows.map((r, i) => (
        <Fragment>
          {i > 0 && <svg class="a-case__rule" viewBox="0 0 1000 24" preserveAspectRatio="none" aria-hidden="true"><path d={cutLine(37)} /></svg>}
          <dl class="a-case__meta">{r.map((m) => <div><dt>{m.label}</dt>{m.items.map((it) => <dd>{typeof it === 'string' ? it : <Fragment>{it.url ? <a href={it.url} target="_blank" rel="noopener">{it.name}</a> : <span class="a-case__name">{it.name}</span>}{it.role && ` – ${it.role}`}</Fragment>}</dd>)}</div>)}</dl>
        </Fragment>
      ))}
      {d.link && (
        <a class="a-cta a-case__cta" href={d.link} target="_blank" rel="noopener">
          <span class="a-cta__paper" data-ring="11" aria-hidden="true"></span>
          Take a look
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" /></svg>
          <span class="sr-only"> at {d.link.replace(/^https?:\/\/(www\.)?/i, '').replace(/\/$/, '')} (opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>


  <!-- the story, with the section rail in the left margin: it starts open beside the first section,
       sticks as the page scrolls and folds to its strokes after ~350px -->
  <div class="a-reading">
    {sections.length > 2 && (
      <div class="a-rail-track">
        <nav class="a-rail" aria-label="Sections">
          <ol>
            {nav.map((s) => <li><a href={`#${s.id}`} data-section={s.id}><span class="a-rail__tick" aria-hidden="true"></span><span class="a-rail__label">{s.label}</span></a></li>)}
          </ol>
        </nav>
      </div>
    )}
    <div class="a-story a-wrap" data-story>
      <Content />
    </div>
  </div>

  <nav class="a-wrap a-next" aria-label="Next project">
    <a class="a-col a-next__link" href={caseHref(base, next.id)}>
      <span class="a-next__text">
        <span class="a-case__label">Next project</span>
        <span class="a-next__title">{next.data.headline}</span>
      </span>
      <Image class="a-next__thumb" src={next.data.cover} alt="" width={700} sizes="(min-width: 900px) 350px, 100vw" />
    </a>
  </nav>

  <ContactA />
</Next>

<script>
  import '../../../scripts/case-enhance';
  import '../../../scripts/paper-ring'; // the "Take a look" button
  // highlighted sentences ({% mark %}) are drawn in once they are well into the screen
  const marks = document.querySelectorAll<HTMLElement>('.cs-mark');
  const seen = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-drawn'); seen.unobserve(e.target); } }), { rootMargin: '0px 0px -25% 0px' });
  marks.forEach((m) => seen.observe(m));
  // Rail: the current section is the last one whose heading passed the top third of the screen.
  // It stays open until the page has scrolled ~350px past the point where the rail sticks.
  const rail = document.querySelector<HTMLElement>('.a-rail');
  const track = document.querySelector<HTMLElement>('.a-rail-track');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.a-rail [data-section], .a-toc [data-section]')];
  // the phone menu: opens and closes; a choice, Esc or a tap outside closes it; its bar names the current section
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const tocBtn = toc?.querySelector<HTMLButtonElement>('.a-toc__bar');
  const tocPanel = toc?.querySelector<HTMLElement>('.a-toc__panel');
  const tocCurrent = toc?.querySelector<HTMLElement>('[data-toc-current]');
  const setToc = (open: boolean) => { if (!tocBtn || !tocPanel) return; tocBtn.setAttribute('aria-expanded', String(open)); tocPanel.hidden = !open; toc!.classList.toggle('is-open', open); };
  tocBtn?.addEventListener('click', () => setToc(tocBtn.getAttribute('aria-expanded') !== 'true'));
  tocPanel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setToc(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && tocBtn?.getAttribute('aria-expanded') === 'true') { setToc(false); tocBtn.focus(); } });
  document.addEventListener('click', (e) => { if (toc && !toc.contains(e.target as Node)) setToc(false); });
  const nav = [...document.querySelectorAll<HTMLAnchorElement>('.a-rail [data-section]')].map((a) => ({ id: a.dataset.section!, label: a.textContent!.trim() }));
  const targets = [...new Set(links.map((a) => a.dataset.section!))].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    let active = '';
    let ticking = false;
    const update = () => {
      ticking = false;
      if (rail && track) {
        const stuckFor = parseFloat(getComputedStyle(rail).top) - track.getBoundingClientRect().top; // px scrolled since it stuck
        rail.classList.toggle('is-open', stuckFor < 350);
      }
      const line = innerHeight * 0.33;
      let id = '';
      targets.forEach((t) => { if (t.getBoundingClientRect().top < line) id = t.id; });
      if (id === active) return;
      active = id;
      links.forEach((a) => (a.dataset.section === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      if (tocCurrent) tocCurrent.textContent = nav.find((n) => n.id === id)?.label ?? 'Intro';
    };
    update();
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  }
</script>
