---
// Version A home (the chosen direction), also behind every /tests page. A one-sentence intro with
// my name (its speaker follows, on a paper cut-out like the logo's), then each featured project on its own sheet, the rest
// of the work as a list on gray paper (hovering a row shows its cover), a short About and contact.
// featured: how each featured project is shown
//   'split'        short title + Industry / Role on the left, a big visual on the right (default)
//   'client'       the same, with the client above the title and only the role below it
//   'screen-1..3'  one screen per project: a big title over a visual sized to fit the screen;
//                  2 adds the client as a paper tab on the visual, 3 puts Role / For beside the title
// button: a round paper button with an arrow beside each featured project's facts (on by default)
// highlight: "designer" and "builder" get the hand-drawn marker of zakariaelk.com, in the logo blue
//   (or 'peach', the colour on zakariaelk.com)
import { getImage } from 'astro:assets';
import Next from '../../../layouts/Next.astro';
import FramedMedia from '../FramedMedia.astro';
import ProjectTeaser from '../../video/ProjectTeaser.astro';
import ContactA from './ContactA.astro';
import IntroA from './IntroA.astro';
import { blob, cutMask, tabCut, unevenRect } from '../../../lib/papercut';
import { workList, caseHref, LIST_LINES, SHORT_TITLES } from '../../../lib/versions';
import '../../../styles/next-a.css';
import '../../../styles/next-a-looks.css';
import '../../../styles/media-a.css';

type Featured = 'split' | 'client' | 'screen-1' | 'screen-2' | 'screen-3';
// intro: the opening animation (the home page only, not the tests)
// base: where the links stay; caseBase: where the INSO case lives (defaults to base); look: a colour or type variation (/tests/orange-theme/, /tests/serif-option/)
// hero 'v1': the earlier one-sentence intro ("I'm Zakaria El Khachia, a product designer…"), three lines on desktop (/v1/)
// leadVideo / leadPoster: the first featured case shows this teaser (components/video/ProjectTeaser.astro),
// with a "Full video" button that opens the case and plays the full video there (the site home)
interface Props { leadVideo?: string; leadPoster?: string; hero?: 'v1'; featured?: Featured; highlight?: 'blue' | 'peach' | false; title?: string; intro?: boolean; button?: boolean; base?: string; caseBase?: string; look?: 'orange' | 'dmsans' | 'blue' | 'brown' }
const { leadVideo, leadPoster, hero, featured: layout = 'split', highlight = 'blue', title = 'Zakaria El Khachia · Product designer & builder', intro = false, button = true, base = '/next/a/', caseBase, look } = Astro.props;
const caseRoot = caseBase ?? base;

const { featured, more } = await workList();
const screen = layout.startsWith('screen');
const titleOf = (p: (typeof featured)[number]['p']) => SHORT_TITLES[p.id] ?? p.data.statement ?? p.data.intro;
const orgOf = (p: (typeof featured)[number]['p']) => p.data.org ?? p.data.client;
// covers for the list's hover preview, loaded on the first hover
const peeks = await Promise.all(more.map(async (p) => (await getImage({ src: p.data.cover, width: 720, format: 'webp' })).src));
const sentence = hero === 'v1'
  ? "I'm Zakaria El Khachia, a product designer and builder. I spent the last five years at INSO making safety information accessible and clearer for humanitarian workers in conflict zones."
  : "I'm a product designer and builder whose name happens to be Zakaria El Khachia.";
const mark = highlight ? ['a-mark', highlight === 'peach' && 'a-mark--peach'] : [];
---
<Next base={base} variant="a" logo work="#work" intro={intro} enter look={look} title={title} description="Product designer and builder. Most recently, safety tools for humanitarian workers at INSO.">
  <section class:list={['a-hero a-wrap', hero === 'v1' && 'a-hero--v1']}>
    {hero === 'v1' ? (
      <h1 class="a-statement" aria-label={sentence}><span class="a-s1">I'm Zakaria El Khachi<span class="a-say-a">a<button type="button" class="n-say a-say" aria-label="Hear how to say Zakaria El Khachia" data-audio="/audio/zakaria-el-khachia.mp3"><svg class="a-say__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3l4.5-4v13L7 14.5H4z" /><path class="wave" d="M15 9.2a4 4 0 0 1 0 5.6" /><path class="wave" d="M17.8 6.6a7.6 7.6 0 0 1 0 10.8" /></svg></button></span>, a product <span class:list={mark}>designer</span> and <span class:list={mark}>builder</span>.</span> <span class="a-s2">I spent the last five years at <a href="https://ngosafety.org" target="_blank" rel="noopener">INSO</a> making safety information<br class="a-br-d" /> accessible and clearer for humanitarian workers in conflict zones.</span></h1>
    ) : (<Fragment>
    <h1 class="a-statement a-lead" aria-label={sentence}>I'm a product <span class:list={mark}>designer</span> and <span class:list={mark}>builder</span> whose<br class="a-lead__br" /> name happens to be Zakaria El <span class="a-say-a">Khachia.<button type="button" class="n-say a-say" aria-label="Hear how to say Zakaria El Khachia" data-audio="/audio/zakaria-el-khachia.mp3"><svg class="a-say__bg" viewBox="0 0 100 100" aria-hidden="true"><path d={blob(61, 50, 50, 47)} /></svg><svg class="a-say__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3l4.5-4v13L7 14.5H4z" /><path class="wave" d="M15 9.2a4 4 0 0 1 0 5.6" /><path class="wave" d="M17.8 6.6a7.6 7.6 0 0 1 0 10.8" /></svg></button></span></h1>
    <p class="a-more"><span class="a-more__long">I started as a web designer in 2013, moved into frontend development and project management, and spent the last five years at <a href="https://ngosafety.org" target="_blank" rel="noopener">INSO</a> designing tools that keep NGO workers informed in conflict zones.</span><span class="a-more__short">Most recently at <a href="https://ngosafety.org" target="_blank" rel="noopener">INSO</a>, making safety information clearer for humanitarian workers.</span></p>
    </Fragment>)}
  </section>

  <section class="a-work" id="work" aria-labelledby="work-title">
    <h2 class="sr-only" id="work-title">Featured work</h2>
    {featured.map(({ p, video, poster, posterSrc }, i) => (
      <div class="n-band n-band--light a-band">
        <div class="n-cut n-cut--top" style={cutMask(7 + i * 13)} aria-hidden="true"></div>
        <div class="a-wrap">
          {screen ? (
            <article class="a-screen">
              <a class="a-screen__link" href={caseHref(caseRoot, p.id)}>
                <div class:list={['a-screen__head', layout === 'screen-3' && 'a-screen__head--meta']}>
                  <h3 class="a-screen__title">{titleOf(p)}</h3>
                  {layout === 'screen-3' && (
                    <dl class="a-meta">
                      {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
                      <div><dt>For</dt><dd>{orgOf(p)}</dd></div>
                    </dl>
                  )}
                </div>
                <div class="a-screen__visual">
                  {layout === 'screen-2' && <span class="n-tag a-screen__client" style={`--tab:${tabCut(5 + i * 4)}`}>{orgOf(p)}</span>}
                  <FramedMedia frame={false} cut={unevenRect(31 + i * 7, 0.6)} image={poster ?? p.data.cover} video={video} posterSrc={posterSrc} alt={`${orgOf(p)}: ${p.data.projectName ?? p.data.title}`} eager={i === 0} />
                </div>
              </a>
            </article>
          ) : (
            i === 0 && leadVideo ? (
              <article class="a-feat a-feat--lead a-feat--player">
                <div class="a-feat__link">
                  {layout === 'client' && <p class="a-feat__client">{orgOf(p)}</p>}
                  <h3 class="a-feat__title"><a href={caseHref(caseRoot, p.id)}>{titleOf(p)}</a></h3>
                  <div class="a-feat__meta">
                    <dl class="a-meta">
                      {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
                      {layout === 'split' && p.data.sector && <div><dt>Industry</dt><dd>{p.data.sector}</dd></div>}
                    </dl>
                    {button && <a class="a-cta a-feat__cta" href={caseHref(caseRoot, p.id)}><span class="a-cta__paper" data-ring={String(41 + i * 6)} aria-hidden="true"></span>See case study<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" /></svg></a>}
                  </div>
                  <div class="a-feat__visual">
                    <ProjectTeaser src={leadVideo} poster={leadPoster ?? ''} caseHref={caseHref(caseRoot, p.id)} fullHref={`${caseHref(caseRoot, p.id)}?play=1#full-video`} label="Play the full INSO alerts video" />
                  </div>
                </div>
              </article>
            ) : (
            <article class:list={['a-feat', i === 0 && 'a-feat--lead']}>
              <a class="a-feat__link" href={caseHref(caseRoot, p.id)}>
                {layout === 'client' && <p class="a-feat__client">{orgOf(p)}</p>}
                <h3 class="a-feat__title">{titleOf(p)}</h3>
                <div class="a-feat__meta">
                  <dl class="a-meta">
                    {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
                    {layout === 'split' && p.data.sector && <div><dt>Industry</dt><dd>{p.data.sector}</dd></div>}
                  </dl>
                  {button && <span class="a-cta a-feat__cta" aria-hidden="true"><span class="a-cta__paper" data-ring={String(41 + i * 6)}></span>See case study<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="3" /></svg></span>}
                </div>
                <div class="a-feat__visual">
                  <FramedMedia frame={false} cut={unevenRect(31 + i * 7, 0.8)} image={poster ?? p.data.cover} video={video} posterSrc={posterSrc} alt={`${orgOf(p)}: ${p.data.projectName ?? p.data.title}`} sizes="(min-width: 900px) 54vw, 92vw" eager={i === 0} />
                </div>
              </a>
            </article>
            )
          )}
        </div>
      </div>
    ))}
  </section>

  <div class="n-band a-band--gray">
    <div class="n-cut n-cut--top" style={cutMask(53)} aria-hidden="true"></div>
    <section class="n-list n-wrap a-selected" aria-labelledby="more-label" data-peek-list>
      <h2 class="n-label" id="more-label"><span class="n-tag" style={`--tab:${tabCut(19)}`}>Other work</span></h2>
      <ul>
        {more.map((p, i) => (
          <li>
            <a href={caseHref(caseRoot, p.id)} data-peek={i}>
              <span class="n-list__name">{p.data.client}</span>
              <span class="n-list__desc">{LIST_LINES[p.id] ?? p.data.intro}</span>
              <span class="n-list__year">{p.data.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="n-cut n-cut--bottom" style={cutMask(61)} aria-hidden="true"></div>
  </div>

  <ContactA />

  {intro && <IntroA />}

  <!-- the list's hover preview: outside the paper bands, whose filters would trap a fixed position -->
  <div class="a-peek" aria-hidden="true">
    <div class="a-peek__card" style={`--cut:${unevenRect(77, 0.6)}`}>
      {peeks.map((src) => <img data-src={src} alt="" width="720" height="432" decoding="async" />)}
    </div>
  </div>
</Next>

<script>
  import '../../../scripts/list-peek';
  import '../../../scripts/enter-a';
  // "Selected Work" gets its marker when it reaches the middle of the screen
  const marks = document.querySelectorAll<HTMLElement>('[data-mark-in-view]');
  const seen = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-drawn'); seen.unobserve(e.target); } }), { rootMargin: '-45% 0px -45% 0px' });
  marks.forEach((m) => seen.observe(m));
  import '../../../scripts/paper-ring'; // the "See case study" buttons
  // highlight: the marker is drawn once the hero text is in ("builder" follows "designer")
  const draw = () => window.setTimeout(() => document.querySelectorAll('.a-hero .a-mark').forEach((m) => m.classList.add('is-drawn')), 300);
  if (document.documentElement.classList.contains('is-enter')) document.addEventListener('ze:enter-hero-done', draw, { once: true });
  else window.setTimeout(draw, 500);
</script>
