---
// Wireframe (draft, not linked): the case study page after layout sketch v2 and content v3, with
// grey boxes for visuals and blue notes for decisions. Real header, fonts and widths; nothing here
// is wired to the content collection.
import Next from '../../layouts/Next.astro';
import ContactA from '../../components/next/va/ContactA.astro';
import '../../styles/next-a.css';
import '../../styles/next-a-looks.css';

const sections = ['Product', 'Context', 'Users', 'Login', 'Alerts', 'Alert detail', 'Maps', 'After the first release', 'Outcome', 'Reflection'];
const id = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
---
<Next base="/" variant="a" logo look="blue" title="Wireframe · Case study">
  <!-- Section rail: strokes at the far left, the names on hover; the current section's stroke is longer -->
  <nav class="wf-rail" aria-label="Sections">
    <ol>{sections.map((s, i) => <li><a href={`#${id(s)}`} aria-current={i === 3 ? 'true' : undefined}><span class="wf-rail__tick"></span><span class="wf-rail__label">{s}</span></a></li>)}</ol>
  </nav>

  <article class="wf">
    <!-- ===== Top (as hansonwu.com/game-breakdowns): label, headline, full-width hero, text column, meta 2×2 ===== -->
    <header class="wf-wrap wf-top">
      <p class="wf-label">INSO · Mobile app</p>
      <h1 class="wf-h1">Keeping humanitarian workers informed on the move</h1>
    </header>
    <div class="wf-wrap wf-bleed"><div class="wf-box wf-hero">Hero visual · full container width (full-bleed on tablets and phones)</div></div>
    <div class="wf-wrap"><div class="wf-col wf-gap-l">
      <p class="wf-p">INSO shares real-time safety alerts with NGOs working in high-risk areas, traditionally by SMS and email.</p>
      <p class="wf-p">A mobile app was meant to replace those channels, but it had been built engineering-first and felt technical to people reading alerts under pressure. As the sole designer, I redesigned onboarding, the alert list, alert details and three map modes, testing with colleagues along the way. After launch, 79% of surveyed partners rated it easy to use.</p>
      <dl class="wf-meta">
        <div><dt>Role</dt><dd>Sole product designer</dd></div>
        <div><dt>Team</dt><dd>2 engineers + department lead</dd></div>
        <div><dt>Timeline</dt><dd>Dec 2022–Jun 2023, 2025 update</dd></div>
        <div><dt>Deliverables</dt><dd>Research, UX/UI, testing, launch assets</dd></div>
      </dl>
      <p class="wf-link"><a href="https://app.ngosafety.org/" target="_blank" rel="noopener">app.ngosafety.org ↗</a></p>
      <p class="wf-note">Text column 860px, centred in the container (reference). Meta 2×2 inside it: labels serif ink, values sans grey.</p>
    </div></div>

    <!-- ===== Body ===== -->
    <section class="wf-sec" id="product">
      <div class="wf-wrap"><div class="wf-col">
        <p class="wf-label">Product</p>
        <h2 class="wf-h2">A mobile way to access real-time incident alerts</h2>
        <p class="wf-p">INSO provides NGO workers with incident alerts in their regions, traditionally delivered by SMS and email. These channels work for broadcasting but are limited when it comes to organising, filtering and interacting with alerts in real situations…</p>
      </div></div>
      <div class="wf-wrap wf-bleed wf-gap-m"><div class="wf-box wf-full">Figure · full container width · app structure overview (video)</div></div>
      <div class="wf-wrap wf-two wf-gap-s"><div class="wf-box wf-half">Figure · half</div><div class="wf-box wf-half">Figure · half</div></div>
      <div class="wf-wrap"><p class="wf-col wf-cap">Caption, small and grey, tight under the figure</p></div>
    </section>

    <section class="wf-sec" id="context">
      <div class="wf-wrap"><div class="wf-col">
        <p class="wf-label">Context</p>
        <h2 class="wf-h2">The app existed, but the experience did not match the users or the product's potential</h2>
        <p class="wf-p">Opens with the curiosity story (brown and beige)… then "Where it came from".</p>
        <aside class="wf-friction"><p class="wf-k">Friction</p><p>The solution came first and its value was named later, so there was no problem statement to design against… (3 sentences at most)</p></aside>
      </div></div>
      <div class="wf-wrap wf-bleed wf-gap-m"><div class="wf-box wf-full wf-before">Before · what the app looked like when I joined (grey)</div></div>
    </section>

    <section class="wf-sec" id="login">
      <div class="wf-wrap"><div class="wf-col">
        <p class="wf-label">Login</p>
        <h2 class="wf-h2">Users were asked to act before understanding what the app does</h2>
        <p class="wf-need"><span>Need:</span> understand what the app is for before being asked for anything.</p>
        <p class="wf-p">The app opened on a login form and asked for location access first.</p>
        <aside class="wf-friction"><p class="wf-k">Friction</p><p>When I asked country-office colleagues whether this would be clear to partners, they felt a welcome email explaining the app would be enough. I disagreed… The explanation had to live inside the app.</p></aside>
        <h3 class="wf-h3">So I introduced a simple onboarding before login</h3>
        <p class="wf-p">I added two onboarding screens to explain the app's purpose and value…</p>
      </div></div>
      <div class="wf-wrap wf-two wf-gap-m"><div class="wf-box wf-half wf-before">Before (grey)</div><div class="wf-box wf-half wf-after">After (blue), annotated</div></div>
      <div class="wf-wrap"><p class="wf-col wf-cap">Login screen before and after. Smart validation was one of the main updates.</p></div>
      <div class="wf-wrap"><div class="wf-col wf-gap-m">
        <div class="wf-result"><p class="wf-num">24 of 31</p><p class="wf-rl">partners rated installation and onboarding 4 or 5 out of 5 (average 4.1/5)</p><p class="wf-rs">I didn't measure the old version, so this shows satisfaction after the change, not an improvement.</p></div>
        <p class="wf-note">Every section: label → story-beat heading → Need → ≤ 3 paragraphs → figure(s) → Friction (max 1) → what I did → Result (max 1).</p>
      </div></div>
    </section>

    <section class="wf-sec" id="alerts"><div class="wf-wrap"><div class="wf-col"><p class="wf-label">Alerts</p><h2 class="wf-h2">The main screen had all the information, but it was hard to read and scan</h2><p class="wf-note">Need · figure · Friction (13 testers, 66/100) · Result (10 of 10 in 22s · 13 of 13 in 19s)</p></div></div></section>
    <section class="wf-sec" id="alert-detail"><div class="wf-wrap"><div class="wf-col"><p class="wf-label">Alert detail</p><h2 class="wf-h2">I am in an alert. What information will help me the most?</h2><p class="wf-p">Research with INSO colleagues showed… <mark class="wf-confirm">[CONFIRM: "INSO colleagues" is right, unless this research really included partners or NGO workers.]</mark></p></div></div></section>
    <section class="wf-sec" id="maps"><div class="wf-wrap"><div class="wf-col"><p class="wf-label">Maps</p><h2 class="wf-h2">Seeing incidents on a map changes everything</h2>
      <ol class="wf-ways"><li><strong>Way of working 1</strong> · Explore · Need · Friction · Result (8 of 8, 33s)</li><li><strong>Way of working 2</strong> · Proximity · Need · Friction <mark class="wf-confirm">[CONFIRM: radius]</mark> · What I did · Result (6 of 6)</li><li><strong>Way of working 3</strong> · Geofence · Need · Friction · What I did · Result (no retest, 9 of 30)</li></ol></div></div></section>
    <section class="wf-sec" id="after-the-first-release"><div class="wf-wrap"><div class="wf-col"><p class="wf-label">After the first release</p><p class="wf-p">Interviews and working sessions with INSO colleagues shaped what came next: six short bold-led lines.</p></div></div></section>

    <!-- ===== End ===== -->
    <section class="wf-sec" id="outcome">
      <div class="wf-wrap"><div class="wf-col"><p class="wf-label">Outcome</p><p class="wf-p">Of the 31 partners who answered a post-launch survey, 79% rated ease of use 4 or 5 out of 5…</p></div></div>
      <div class="wf-wrap wf-gap-m"><ul class="wf-strip"><li><p class="wf-num">79%</p><p class="wf-rl">rated ease of use 4 or 5 out of 5 · 23 of 29</p></li><li><p class="wf-num">24 of 31</p><p class="wf-rl">rated installation and onboarding 4 or 5 · avg 4.1/5</p></li><li><p class="wf-num">93%</p><p class="wf-rl">named alert notifications the most important feature · 28 of 30</p></li></ul></div>
      <div class="wf-wrap"><div class="wf-col wf-gap-m"><p class="wf-label">Takeaways</p><p class="wf-p">Design for the worst connection first · Test with proxies, then close the loop · Security and usability pull against each other.</p></div></div>
    </section>
    <section class="wf-sec" id="reflection"><div class="wf-wrap"><div class="wf-col"><p class="wf-label">Reflection</p><p class="wf-p">What I'd do differently (3) · Still unsolved (4)</p></div></div></section>
    <div class="wf-wrap wf-sec"><div class="wf-col wf-next"><div><p class="wf-label">Next project</p><p class="wf-p">INSO — Redesigning and building ngosafety.org</p></div><div class="wf-box wf-thumb">Thumbnail</div></div></div>
  </article>
  <ContactA />
</Next>

<style>
  /* wireframe only: widths, type and spacing after hansonwu.com/game-breakdowns, in this site's fonts */
  .wf { --wf-blue: #2f6fd6; --wf-grey: #e9e9e9; --wf-tint: #eef5ff; --wf-pad: clamp(16px, calc(16px + 48 * (100vw - 768px) / 512), 64px); }
  :root[data-theme='dark'] .wf { --wf-grey: #2a2a2a; --wf-tint: #1d2633; --wf-blue: #8fb6f5; }
  .wf-wrap { max-width: 1440px; margin-inline: auto; padding-inline: var(--wf-pad); }
  .wf-col { max-width: 860px; margin-inline: auto; }                       /* the text column: 860px, centred */
  .wf-note { margin: 16px 0 0; font: 400 13px/1.45 ui-monospace, Menlo, monospace; color: var(--wf-blue); }
  .wf-top { padding-top: clamp(40px, 6vw, 96px); }
  .wf-label { margin: 0; font-family: var(--sans); font-size: clamp(16px, calc(16px + 8 * (100vw - 768px) / 512), 24px); line-height: 1.15; color: var(--muted); }
  .wf-h1 { margin: clamp(12px, 2vw, 24px) 0 0; font-family: var(--serif); font-weight: 470; font-size: clamp(32px, calc(32px + 28 * (100vw - 768px) / 512), 60px); line-height: 1.2; letter-spacing: -0.01em; }
  .wf-box { display: grid; place-items: center; padding: 16px; background: var(--wf-grey); color: var(--muted); font: 400 14px/1.4 ui-monospace, Menlo, monospace; text-align: center; }
  .wf-hero { margin-top: clamp(32px, 7vw, 108px); aspect-ratio: 1.365; }
  .wf-gap-l { margin-top: clamp(48px, 10vw, 160px); }
  .wf-gap-m { margin-top: clamp(40px, 6vw, 96px); }
  .wf-gap-s { margin-top: clamp(16px, 5vw, 64px); }
  .wf-p { margin: 0 0 1em; font-family: var(--serif); font-weight: 470; font-size: clamp(20px, calc(20px + 8 * (100vw - 768px) / 512), 28px); line-height: 1.5; }
  .wf-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px) 32px; margin: clamp(40px, 6vw, 96px) 0 0; }
  .wf-meta dt { font-family: var(--serif); font-weight: 470; font-size: clamp(16px, calc(16px + 8 * (100vw - 768px) / 512), 24px); line-height: 1.5; }
  .wf-meta dd { margin: 8px 0 0; font-family: var(--sans); font-size: clamp(16px, calc(16px + 8 * (100vw - 768px) / 512), 24px); line-height: 1.15; color: var(--muted); }
  .wf-link { margin: clamp(24px, 3vw, 40px) 0 0; font-family: var(--sans); font-size: clamp(16px, 1.6vw, 20px); }
  .wf-link a { color: inherit; text-underline-offset: 0.2em; }
  .wf-sec { padding-top: clamp(96px, 14vw, 200px); }
  .wf-h2 { margin: 16px 0 24px; font-family: var(--serif); font-weight: 470; font-size: clamp(26px, calc(26px + 14 * (100vw - 768px) / 512), 40px); line-height: 1.2; letter-spacing: -0.01em; }
  .wf-h3 { margin: 40px 0 12px; font-family: var(--serif); font-weight: 500; font-size: clamp(22px, calc(22px + 6 * (100vw - 768px) / 512), 28px); line-height: 1.3; }
  .wf-need { margin: 0 0 1em; font-family: var(--serif); font-weight: 560; font-size: clamp(20px, calc(20px + 8 * (100vw - 768px) / 512), 28px); line-height: 1.5; }
  .wf-full { aspect-ratio: 1.365; }
  .wf-two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 5vw, 64px); }
  .wf-half { aspect-ratio: 0.86; }
  .wf-cap { margin: 12px auto 0; font-family: var(--sans); font-size: clamp(14px, 1.3vw, 16px); color: var(--muted); }
  .wf-friction { margin: 32px 0; padding: 4px 0 4px 24px; border-left: 3px solid var(--wf-blue); }
  .wf-friction p { margin: 0; font-family: var(--serif); font-size: clamp(20px, calc(20px + 8 * (100vw - 768px) / 512), 28px); line-height: 1.5; }
  .wf-k { margin-bottom: 8px !important; font-family: var(--sans) !important; font-size: clamp(14px, 1.3vw, 16px) !important; color: var(--wf-blue); }
  .wf-before { background: #d9d9d9; }
  .wf-after { background: #cfe0fb; color: #23406f; }
  :root[data-theme='dark'] .wf-before { background: #333; }
  :root[data-theme='dark'] .wf-after { background: #22344f; color: #cfe0fb; }
  .wf-result { padding: clamp(20px, 3vw, 32px); background: var(--wf-tint); }
  .wf-num { margin: 0; font-family: var(--serif); font-weight: 470; font-size: clamp(40px, 5vw, 64px); line-height: 1; }
  .wf-rl { margin: 12px 0 0; font-family: var(--sans); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.35; }
  .wf-rs { margin: 12px 0 0; font-family: var(--sans); font-size: clamp(14px, 1.3vw, 16px); line-height: 1.4; color: var(--muted); }
  .wf-confirm { padding: 0 4px; border-radius: 3px; background: #fff1a8; color: #3a3000; font-family: var(--sans); font-size: 0.7em; }
  .wf-ways { margin: 0; padding-left: 1.2em; font-family: var(--sans); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.6; }
  .wf-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2.5vw, 32px); margin: 0; padding: 0; list-style: none; }
  .wf-strip li { padding: clamp(20px, 3vw, 32px); background: var(--wf-tint); }
  .wf-next { display: grid; grid-template-columns: 1fr 350px; gap: 32px; align-items: center; }
  .wf-thumb { aspect-ratio: 350 / 240; }
  .wf-rail { position: fixed; left: 0; top: 50%; z-index: 20; transform: translateY(-50%); width: 40px; padding: 16px 16px 16px 14px; overflow: hidden; border-radius: 0 12px 12px 0; font-family: var(--sans); transition: width 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease; }
  .wf-rail:hover, .wf-rail:focus-within { width: 260px; background: var(--bg); box-shadow: 0 16px 48px -20px rgb(0 0 0 / 0.35), 0 0 0 1px var(--line); }
  .wf-rail ol { margin: 0; padding: 0; list-style: none; }
  .wf-rail a { display: flex; align-items: center; gap: 14px; padding: 5px 0; color: var(--muted); font-size: 15px; text-decoration: none; white-space: nowrap; }
  .wf-rail__tick { flex: none; width: 12px; height: 2px; border-radius: 1px; background: currentColor; opacity: 0.45; }
  .wf-rail a[aria-current] { color: var(--ink); }
  .wf-rail a[aria-current] .wf-rail__tick { width: 20px; opacity: 1; background: var(--ink); }
  .wf-rail__label { opacity: 0; transition: opacity 0.15s ease; }
  .wf-rail:hover .wf-rail__label, .wf-rail:focus-within .wf-rail__label { opacity: 1; }
  @media (max-width: 1100px) { .wf-rail { display: none; } }
  /* tablets and phones: visuals full-bleed (reference), pairs and the strip stacked */
  @media (max-width: 900px) {
    .wf-bleed { padding-inline: 0; }
    .wf-two, .wf-strip { grid-template-columns: minmax(0, 1fr); }
    .wf-two { padding-inline: 0; }
    .wf-next { grid-template-columns: minmax(0, 1fr); }
  }
</style>
