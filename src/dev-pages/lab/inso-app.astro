---
// Rewritten INSO app case study on the story template, kept apart for comparison with the
// live version at /work/mitigating-risk-with-location-based-alerts/. Not linked, not indexed.
import { getEntry } from 'astro:content';
import CaseStory from '../../components/story/CaseStory.astro';
