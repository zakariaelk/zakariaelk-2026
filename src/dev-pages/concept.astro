---
// Concept only (not linked from the site): what it could look like to open the site
// with a short cartoon of Zakaria thinking through the process: listen → sketch → build → ship.
// Everything moves in stepped frames with "boiling" lines, like hand-drawn animation.
import '@fontsource-variable/figtree';
import '../styles/global.css';
import CartoonFace from '../components/CartoonFace.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Intro concept | Zakaria El Khachia</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="intro">
      <svg class="stage" viewBox="0 0 1000 700" role="img" aria-label="Cartoon of Zakaria thinking: listen, sketch, build, ship">
        <defs>
          <filter id="boil2" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="1" seed="1">
              <animate attributeName="seed" values="1;5;9" dur="0.36s" calcMode="discrete" repeatCount="indefinite" />
            </feTurbulence>
            <feDisplacementMap in="SourceGraphic" scale="3.5" />
          </filter>
        </defs>

        <g filter="url(#boil2)" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
          <!-- backdrop circles, same motif as the logo -->
          <circle cx="792" cy="412" r="220" fill="var(--coral)" stroke="none" />
          <circle cx="776" cy="396" r="220" fill="var(--paper)" stroke="none" />

        </g>

        <!-- the cartoon head, looking up at the thought -->
        <CartoonFace look="up" x={600} y={200} width={340} height={391} />

        <g filter="url(#boil2)" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
          <!-- thought dots -->
          <circle class="dot d1" cx="682" cy="258" r="7" fill="var(--white)" />
          <circle class="dot d2" cx="642" cy="282" r="10" fill="var(--white)" />
          <circle class="dot d3" cx="590" cy="306" r="14" fill="var(--white)" />

          <g transform="translate(-67 -22) scale(1.25)">
          <!-- the cloud -->
          <path class="cloud" fill="var(--white)" d="M120 250c-50 0-66-70-20-86-18-54 42-92 84-62 20-50 96-56 124-12 34-40 108-26 118 30 50 4 66 70 20 94 14 50-40 84-80 62-24 36-90 40-118 6-36 30-100 22-118-20-6-4-8-8-10-12z" />

          <!-- scene 1: listen -->
          <g class="scene s1">
            <path d="M170 120h110a14 14 0 0 1 14 14v44a14 14 0 0 1-14 14h-62l-24 20v-20h-24a14 14 0 0 1-14-14v-44a14 14 0 0 1 14-14z" fill="var(--sun)" />
            <text x="225" y="170" class="big">?</text>
            <path class="pop2" d="M300 150h70a12 12 0 0 1 12 12v34a12 12 0 0 1-12 12h-14v18l-20-18h-36a12 12 0 0 1-12-12v-34a12 12 0 0 1 12-12z" fill="var(--paper)" />
            <text class="pop2 big" x="335" y="193">!</text>
            <text x="266" y="262" class="label">listen</text>
          </g>

          <!-- scene 2: sketch -->
          <g class="scene s2">
            <rect class="draw" x="170" y="112" width="190" height="120" rx="10" pathLength="100" />
            <path class="draw late" d="M190 138h80M190 160h120M190 182h60" pathLength="100" />
            <rect class="draw later" x="290" y="176" width="52" height="38" rx="6" fill="var(--coral)" pathLength="100" />
            <g class="pencil">
              <path d="M360 90l22 22-44 44-26 6 6-26z" fill="var(--sun)" />
              <path d="M360 90l10-10 22 22-10 10" fill="var(--coral)" />
            </g>
            <text x="266" y="262" class="label">sketch</text>
          </g>

          <!-- scene 3: build -->
          <g class="scene s3">
            <path d="M200 130l-34 34 34 34M330 130l34 34-34 34M285 118l-40 94" stroke-width="6" />
            <path class="type t1" d="M170 228h60" stroke="var(--coral)" stroke-width="7" />
            <path class="type t2" d="M244 228h50" stroke="var(--ink)" stroke-width="7" />
            <path class="type t3" d="M308 228h52" stroke="var(--blue)" stroke-width="7" />
            <text x="266" y="270" class="label">build</text>
          </g>

          <!-- scene 4: ship -->
          <g class="scene s4">
            <path class="trail" d="M150 230c40-10 50-60 90-60s40 40 80 20 30-60 70-80" stroke-dasharray="2 12" />
            <g class="plane">
              <path d="M380 96l56-20-14 52-12-16z" fill="var(--white)" />
              <path d="M410 112l26-36" />
            </g>
            <text x="266" y="262" class="label">ship!</text>
          </g>

          </g>

          <!-- idea bulb, pops up at "ship" -->
          <g transform="translate(26 64)"><g class="bulb">
            <path d="M720 96a34 34 0 1 1 44 0c-6 6-8 12-8 20h-28c0-8-2-14-8-20z" fill="var(--sun)" />
            <path d="M730 128h24M734 140h16" />
            <path d="M742 34v-18M790 52l12-12M694 52l-12-12M806 92h16M676 92h-16" stroke-width="5" />
          </g></g>
        </g>
      </svg>

      <div class="intro__text">
        <p class="intro__name">Zakaria El Khachia</p>
        <p class="intro__role">Product designer &amp; builder</p>
        <a href="/" class="btn">See the portfolio <span class="arrow" aria-hidden="true">→</span></a>
        <p class="intro__note">Concept: an animated intro before the site opens.</p>
      </div>
    </main>

    <style>
      .intro {
        min-height: 100dvh; display: grid; align-content: center; justify-items: center; gap: 1.5rem;
        padding: 2rem var(--gutter); background: var(--sun); position: relative; overflow: hidden;
      }
      .intro::before {
        content: ''; position: absolute; inset: auto -20vw -40vw auto; width: 80vw; height: 80vw; border-radius: 50%;
        background: radial-gradient(closest-side, rgba(255, 90, 54, 0.3), rgba(255, 90, 54, 0) 70%); pointer-events: none;
      }
      .stage { width: min(100%, 1000px, calc((100dvh - 12rem) * 1000 / 700)); height: auto; overflow: visible; position: relative; }
      .stage :global(*) { transform-box: fill-box; }
      .stage text { stroke: none; fill: var(--ink); font-family: var(--font); font-weight: 800; text-anchor: middle; }
      .stage .big { font-size: 46px; }
      .stage .label { font-size: 30px; letter-spacing: -0.01em; }


      /* Thought dots and cloud pop in, frame by frame */
      .dot, .cloud { transform-origin: center; animation: pop 0.45s steps(3) both; }
      .d1 { animation-delay: 0.2s; } .d2 { animation-delay: 0.4s; } .d3 { animation-delay: 0.6s; } .cloud { animation-delay: 0.8s; }

      /* Four scenes, 2.5s each, in a 10s loop */
      .scene { --t: 10s; opacity: 0; animation: scene var(--t) steps(1) infinite; animation-delay: var(--d); }
      .s1 { --d: -10s; } .s2 { --d: -7.5s; } .s3 { --d: -5s; } .s4 { --d: -2.5s; }
      @keyframes scene { 0% { opacity: 1; } 25%, 100% { opacity: 0; } }
      .scene > * { animation-delay: var(--d) !important; }

      .pop2 { transform-origin: center; animation: pop2 10s steps(1) infinite; }
      @keyframes pop2 { 0%, 8% { opacity: 0; } 9%, 100% { opacity: 1; } }

      .draw { stroke-dasharray: 100; stroke-dashoffset: 100; animation: sketch 10s steps(1) infinite; }
      .draw.late { animation-name: sketch-late; } .draw.later { animation-name: sketch-later; }
      @keyframes sketch { 0% { stroke-dashoffset: 100; } 3% { stroke-dashoffset: 66; } 6% { stroke-dashoffset: 33; } 9%, 100% { stroke-dashoffset: 0; } }
      @keyframes sketch-late { 0%, 9% { stroke-dashoffset: 100; } 12% { stroke-dashoffset: 50; } 15%, 100% { stroke-dashoffset: 0; } }
      @keyframes sketch-later { 0%, 15% { stroke-dashoffset: 100; fill-opacity: 0; } 18% { stroke-dashoffset: 40; fill-opacity: 0; } 21%, 100% { stroke-dashoffset: 0; fill-opacity: 1; } }
      .pencil { animation: pencil 10s steps(1) infinite; }
      @keyframes pencil { 0% { transform: translate(-190px, 30px); } 3% { transform: translate(-40px, 20px); } 6% { transform: translate(-150px, 90px); } 9% { transform: translate(-120px, 40px); } 12% { transform: translate(-60px, 70px); } 15% { transform: translate(-40px, 90px); } 18% { transform: translate(-20px, 100px); } 21%, 100% { transform: translate(0, 0); } }

      .type { stroke-dasharray: 60; stroke-dashoffset: 60; animation: type1 10s steps(1) infinite; }
      .t2 { animation-name: type2; } .t3 { animation-name: type3; }
      @keyframes type1 { 0%, 3% { stroke-dashoffset: 60; } 6% { stroke-dashoffset: 30; } 9%, 100% { stroke-dashoffset: 0; } }
      @keyframes type2 { 0%, 11% { stroke-dashoffset: 60; } 14% { stroke-dashoffset: 30; } 17%, 100% { stroke-dashoffset: 0; } }
      @keyframes type3 { 0%, 19% { stroke-dashoffset: 60; } 21% { stroke-dashoffset: 30; } 23%, 100% { stroke-dashoffset: 0; } }

      .plane { animation: fly 10s steps(1) infinite; }
      @keyframes fly { 0% { transform: translate(-220px, 130px) rotate(10deg); } 5% { transform: translate(-160px, 70px) rotate(0); } 10% { transform: translate(-90px, 80px) rotate(-8deg); } 15% { transform: translate(-40px, 30px); } 20%, 100% { transform: translate(0, 0) rotate(-6deg); } }
      .trail { stroke-dashoffset: 0; }

      .bulb { opacity: 0; transform-origin: 50% 100%; animation: bulb 10s steps(1) infinite; animation-delay: -2.5s; }
      @keyframes bulb { 0%, 8% { opacity: 0; transform: scale(0.5); } 9% { opacity: 1; transform: scale(1.15); } 12%, 24% { opacity: 1; transform: scale(1); } 25%, 100% { opacity: 0; } }

      .intro__text { position: relative; display: grid; justify-items: center; gap: 0.35rem; text-align: center; }
      .intro__name { font-size: var(--fs-h3); font-weight: var(--fw-bold); letter-spacing: -0.03em; }
      .intro__role { color: var(--ink-soft); margin-bottom: 1rem; }
      .intro__note { margin-top: 1rem; font-size: var(--fs-small); color: var(--ink-soft); }
    </style>
  </body>
</html>
